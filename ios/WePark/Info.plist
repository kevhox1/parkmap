<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  WePark Info.plist (custom-keys-only stub).

	  GENERATE_INFOPLIST_FILE is still YES — Xcode merges this file with
	  values from the INFOPLIST_KEY_* build settings (NSLocationWhenInUseUsageDescription,
	  UISupportedInterfaceOrientations, scene manifest, etc.). Keep this file
	  scoped to custom keys that Xcode's auto-generation cannot inject
	  (INFOPLIST_KEY_<custom> is silently dropped for non-Apple-defined keys).

	  MAPBOX_ACCESS_TOKEN is substituted at build time from the value defined
	  in ios/WePark/Config.xcconfig (gitignored). See Config.xcconfig.example
	  for setup. Read at runtime via:
	    Bundle.main.object(forInfoDictionaryKey: "MAPBOX_ACCESS_TOKEN") as? String
	-->
	<key>MAPBOX_ACCESS_TOKEN</key>
	<string>$(MAPBOX_ACCESS_TOKEN)</string>
</dict>
</plist>
