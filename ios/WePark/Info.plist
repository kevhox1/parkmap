<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Phase 2a: the launch screen is pinned to black (what the dark launch screen was before the
	     Info.plist UIUserInterfaceStyle=Dark key was removed). Flag-flip TODO: add a light variant. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>Fredoka-Regular.ttf</string>
		<string>Fredoka-Medium.ttf</string>
		<string>Fredoka-SemiBold.ttf</string>
		<string>Fredoka-Bold.ttf</string>
	</array>
	<key>MAPBOX_ACCESS_TOKEN</key>
	<string>$(MAPBOX_ACCESS_TOKEN)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
#ifdef SPOT_PASS_AUTODETECT_YES
		<!-- Spot Pass C4 armed-window auto-detect. Present ONLY when the SPOT_PASS_AUTODETECT build
		     setting is YES (default NO in every configuration). See docs/specs/qr-spot-handoff.md 7.4. -->
		<string>location</string>
#endif
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.kevinhoxha.wepark.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wepark</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
