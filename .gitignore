# Claude Code local-only state — keep out of git
.claude/settings.local.json
.claude/worktrees/

# Xcode — user-specific UI state, build artifacts, derived data
**/xcuserdata/
**/*.xcuserstate
**/*.xcuserdatad/
ios/**/build/
DerivedData/

# Swift Package Manager
.swiftpm/
Package.resolved
.build/

# iOS token config — contains real Mapbox token; never commit
ios/WePark/Config.xcconfig

# OS junk
.DS_Store

# Supabase CLI scratch state (created by `supabase functions deploy`) — never commit
supabase/.temp/
